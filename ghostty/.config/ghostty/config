# Font
font-family = "Maple Mono"
font-family = "LXGW WenKai Mono TC"
font-size = 20

# ColorScheme
theme = catppuccin Mocha
background = #000000

# For Mac Option key
macos-option-as-alt = right
keybind = opt+left=text:\x1b[1;3D
keybind = opt+right=text:\x1b[1;3C
keybind = opt+up=text:\x1b[1;3A
keybind = opt+down=text:\x1b[1;3B

# Move forward and backward by word
keybind = cmd+a=text:\x1bb
keybind = cmd+f=text:\x1bf
macos-titlebar-style = hidden
