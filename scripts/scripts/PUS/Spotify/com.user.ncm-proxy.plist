<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.ncm-proxy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/run/current-system/sw/bin/node</string>
    <string>/Users/25air/scripts/PUS/Spotify/ncm-proxy.js</string>
